#!/usr/bin/env ruby

require "fileutils"

def check_commands!(*cmds)
  missing = cmds.reject{|cmd| ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any?{|dir| File.executable?(File.join(dir, cmd))}}
  return if missing.empty?
  STDERR.puts "#{$0} requires #{missing.join(", ")}, not found in PATH"
  exit 1
end

types = {
  "ruby"       => "#!/usr/bin/env ruby",
  "python"     => "#!/usr/bin/env python",
  "python2"    => "#!/usr/bin/env python2",
  "python3"    => "#!/usr/bin/env python3",
  "perl"       => "#!/usr/bin/perl",
  "bash"       => "#!/bin/bash",
}
types["rb"]  = types["ruby"]
types["py"]  = types["python"]
types["py2"] = types["python2"]
types["py3"] = types["python3"]
types["pl"]  = types["perl"]
types["sh"]  = types["bash"]

type = "ruby"
if ARGV[0] =~ /\A--?(.*)/
  ARGV.shift
  type = $1
end

unless bin = types[type]
  warn "No such type: #{type}"
  exit 1
end

check_commands! "chmod" unless ARGV.empty?

ARGV.each do |file_name|
  if File.exist?(file_name)
    warn "Already exists, chmodding only: #{file_name}"
    system "chmod", "+x", file_name
  else
    File.open(file_name, IO::WRONLY|IO::CREAT|IO::EXCL, 0755) do |fh|
      fh.puts bin
    end
  end
end
