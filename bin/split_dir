#!/usr/bin/env ruby

require "pathname"

class Array
  def balanced_slices(max_sz)
    slice_count = (size+max_sz-1) / max_sz
    (0...slice_count).map do |i|
      i0 = i * size / slice_count
      i1 = (i+1) * size / slice_count
      self[i0...i1]
    end
  end
end

max_size = 200

ARGV.each do |d|
  d = Pathname.new(d)
  next unless d.directory?
  cn = d.children
  next if cn.size <= max_size * 1.25 # avoid tiny chunks
  # puts "Splitting #{d} - #{cn.size} files"
  slices = cn.sort.balanced_slices(max_size)
  fmt = "-%0#{slices.size.to_s.size}d"
  n = 0
  slices.each do |fs|
    # A name can be taken by an earlier split or something unrelated, so count
    # up to the next free one instead of dropping the slice
    n += 1
    n += 1 while d.sub(/\/?\Z/, fmt % n).exist?
    dn = d.sub(/\/?\Z/, fmt % n)
    dn.mkdir
    fs.each do |f|
      f.rename(dn + f.basename)
    end
  end
  # Only if everything actually moved out
  d.rmdir if d.children.empty?
end
