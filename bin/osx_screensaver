#!/usr/bin/env ruby

def check_commands!(*cmds)
  missing = cmds.reject{|cmd| ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any?{|dir| File.executable?(File.join(dir, cmd))}}
  return if missing.empty?
  STDERR.puts "#{$0} requires #{missing.join(", ")}, not found in PATH"
  exit 1
end

check_commands! "open"

# ScreenSaverEngine.app used to be hidden inside ScreenSaver.framework's
# Resources; on modern OSX it's a normal CoreServices app instead
paths = [
  "/System/Library/CoreServices/ScreenSaverEngine.app",
  "/System/Library/Frameworks/ScreenSaver.framework/Versions/A/Resources/ScreenSaverEngine.app",
]

path = paths.find{|p| File.exist?(p)}

unless path
  STDERR.puts "Can't find ScreenSaverEngine.app, looked in:"
  paths.each{|p| STDERR.puts "  #{p}"}
  exit 1
end

exit 1 unless system "open", path
