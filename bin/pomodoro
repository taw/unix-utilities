#!/usr/bin/env ruby

require "shellwords"

def osa(cmd)
  cmd = %W[osascript -e #{cmd}].map(&:shellescape).join(" ")
  `#{cmd}`
end

# afplay is part of OSX, and system returns nil rather than raising if the
# player isn't there at all, which would end the pomodoro in silence
def play(path)
  warn "Couldn't play `#{path}'" unless system *%W[afplay #{path}]
end

def with_volume(volume)
  old_volume = osa("output volume of (get volume settings)").strip
  osa("set volume output volume #{volume}")
  yield
ensure
  osa("set volume output volume #{old_volume}")
end

# Sleeping 60 at a time drifts by however long the rest of the iteration takes,
# so the pomodoro ran long. Deadlines measured from the start don't accumulate
# that, and one which already passed just doesn't sleep.
def sleep_until(time)
  remaining = time - Time.now
  sleep remaining if remaining > 0
end

def count_minutes!(minutes, time_start=Time.now)
  minutes.times do |i|
    puts "Minutes to go: #{minutes-i}"
    sleep_until time_start + (i+1)*60
  end
end

def pomodoro!(args)
  path = "/System/Library/Sounds/Ping.aiff"
  count_minutes!(args[0] ? args[0].to_i : 25)
  with_volume(100) do
    play path
  end
end

pomodoro!(ARGV) if __FILE__ == $0
