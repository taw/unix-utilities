#!/usr/bin/env ruby

# $VERBOSE = nil

require "cgi"
require "uri"
require "open-uri"
require "json"

# We actually need URI.escape here, with " " becoming %20 not +
def tfl_uri(from, to)
  from_esc = CGI.escape(from).gsub("+", "%20")
  to_esc = CGI.escape(to).gsub("+", "%20")
  "https://api.tfl.gov.uk/Journey/JourneyResults/#{from_esc}/to/#{to_esc}"
end

def travel_time(from, to)
  uri = tfl_uri(from, to)
  data = JSON.parse(URI.open(uri).read)
  data["journeys"].map{|j| j["duration"]}.min
end

# Errors come back as JSON too, but open-uri only gives us the body via the exception
def error_body(err)
  JSON.parse(err.io.read)
rescue StandardError
  {}
end

# 300 Multiple Choices means TfL couldn't pin down `from' and/or `to'
def report_disambiguation(data, from, to)
  [["from", from, "fromLocationDisambiguation"], ["to", to, "toLocationDisambiguation"]].each do |label, value, key|
    options = data.dig(key, "disambiguationOptions") || []
    next if options.empty?
    warn "Ambiguous #{label} location `#{value}', did you mean:"
    options.first(10).each do |option|
      warn "  #{option.dig("place", "commonName")}"
    end
    warn "  ... and #{options.size - 10} more" if options.size > 10
  end
end

unless ARGV.size == 2
  STDERR.puts "Usage: #{$0} <from> <to>"
  exit 1
end

from, to = ARGV
begin
  t = travel_time(from, to)
rescue OpenURI::HTTPError => err
  data = error_body(err)
  if err.io.status[0] == "300"
    report_disambiguation(data, from, to)
  else
    warn "TfL API error (#{err.io.status.join(" ")}): #{data["message"] || "no details"}"
  end
  exit 1
end
if t
  puts t
else
  system "open", tfl_uri(from, to)
  warn "Can't find travel time from `#{from}' to `#{to}'"
end
