#!/usr/bin/env ruby

class ToUTF8
  def has_nul_bytes?
    @data.include?("\0".b)
  end

  def valid_ascii?
    @data.force_encoding("ASCII").valid_encoding?
  end

  def valid_utf8?
    @data.force_encoding("UTF-8").valid_encoding?
  end

  def has_utf8_bom?
    @data[0,3].b == "\xEF\xBB\xBF".b
  end

  def has_utf16le_bom?
    @data[0,2].b  == "\xFF\xFE".b
  end

  def has_utf16be_bom?
    @data[0,2].b  == "\xFE\xFF".b
  end

  def strip_utf8_bom
    @data = @data[3..-1]
  end

  def strip_utf16_bom
    @data = @data[2..-1]
  end

  def guess_utf16le?
    @data.unpack("v*").sum < @data.unpack("n*").sum
  end

  # Every guess here can be wrong, and a mangled character beats a backtrace
  def convert_from(encoding)
    @data = @data.force_encoding(encoding).encode("UTF-8", invalid: :replace, undef: :replace)
  end

  def convert_utf16le
    convert_from("UTF-16LE")
  end

  def convert_utf16be
    convert_from("UTF-16BE")
  end

  # Nothing tells 8bit legacy encodings apart, so just guess the most common
  # one - Windows-1252 is Latin-1 plus printable characters in the C1 range
  def convert_legacy_8bit
    convert_from("Windows-1252")
  end

  def call
    # Just assume no NUL character in input.
    # 00 41 is most likely UTF16 "A", but it's technically valid "\x00A"
    # in ASCII or UTF-8 or Latin1 or just about any encoding.
    # (and same for little endian 41 00)
    #
    # Realistically text files don't contain NUL character.
    @data = ARGF.read.b
    if !has_nul_bytes? and valid_ascii?
      # we're done
    elsif has_utf8_bom?
      strip_utf8_bom
    elsif !has_nul_bytes? and valid_utf8?
      # we're done
    elsif has_utf16le_bom?
      strip_utf16_bom
      convert_utf16le
    elsif has_utf16be_bom?
      strip_utf16_bom
      convert_utf16be
    # Text in UTF-16 is mostly NUL bytes unless it's all non-Latin script, so
    # without a single one of them it's far more likely to be 8bit legacy
    elsif !has_nul_bytes?
      convert_legacy_8bit
    # Asssume it's some kind of UTF-16, which is honestly a bad assumption
    # but it's good enough v1
    elsif guess_utf16le?
      convert_utf16le
    else
      convert_utf16be
    end

    print @data
  end
end

ToUTF8.new.call
