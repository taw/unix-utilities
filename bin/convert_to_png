#!/usr/bin/env ruby

def check_commands!(*cmds)
  missing = cmds.reject{|cmd| ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any?{|dir| File.executable?(File.join(dir, cmd))}}
  return if missing.empty?
  STDERR.puts "#{$0} requires #{missing.join(", ")}, not found in PATH"
  exit 1
end

check_commands! "convert" unless ARGV.empty?

ARGV.each do |fn|
  next if fn =~ /\.png\z/i
  pngfn = fn.sub(/\.([a-z0-9]+)\z/i, ".png")
  if File.exist?(pngfn)
    puts "Not converting #{fn} to #{pngfn} because target exists"
    next
  end
  system "convert", fn, pngfn
end
