#!/usr/bin/env ruby

def check_commands!(*cmds)
  missing = cmds.reject{|cmd| ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any?{|dir| File.executable?(File.join(dir, cmd))}}
  return if missing.empty?
  STDERR.puts "#{$0} requires #{missing.join(", ")}, not found in PATH"
  exit 1
end

check_commands! "open"

if ARGV.empty?
  urls = STDIN.readlines.map(&:chomp).reject(&:empty?)
else
  urls = ARGV
end

system "open", "-na", "Google Chrome", "--args", "--incognito", *urls
