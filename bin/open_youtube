#!/usr/bin/env ruby

def check_commands!(*cmds)
  missing = cmds.reject{|cmd| ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any?{|dir| File.executable?(File.join(dir, cmd))}}
  return if missing.empty?
  STDERR.puts "#{$0} requires #{missing.join(", ")}, not found in PATH"
  exit 1
end

check_commands! "open" unless ARGV.empty?

ARGV.each do |path|
  # This might not be the most reliable Youtube ID extraction regexp ever
  youtube_id = File.basename(path).sub(/\.[^\.]+\z/, "")[/[A-Za-z0-9_-]{11}\z/]
  unless youtube_id
    warn "No Youtube ID found in `#{path}', skipping"
    next
  end
  system "open", "https://www.youtube.com/watch?v=#{youtube_id}"
end
