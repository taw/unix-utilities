#!/usr/bin/env ruby

# This used to call CGSession -suspend for fast user switching to the login
# window, but CGSession only ever shipped inside Menu Extras/User.menu, and Big
# Sur deleted the menu extras. Nothing replaced it, so sleep the machine, which
# is what the name says anyway.
#
# Whether that locks the session depends on your screen lock grace period -
# check with `sysadminctl -screenLock status`.
def check_commands!(*cmds)
  missing = cmds.reject{|cmd| ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any?{|dir| File.executable?(File.join(dir, cmd))}}
  return if missing.empty?
  STDERR.puts "#{$0} requires #{missing.join(", ")}, not found in PATH"
  exit 1
end

check_commands! "pmset"
exit 1 unless system "pmset", "sleepnow"
