#!/usr/bin/env ruby

def check_commands!(*cmds)
  missing = cmds.reject{|cmd| ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any?{|dir| File.executable?(File.join(dir, cmd))}}
  return if missing.empty?
  STDERR.puts "#{$0} requires #{missing.join(", ")}, not found in PATH"
  exit 1
end

check_commands! "gnugo" unless ARGV.empty?

level = 15
ARGV.each do |sgf|
  annotated_sgf = File.dirname(sgf) + "/" + "annotated-" + File.basename(sgf)
  system *[
    'gnugo',
    '--level', "#{level}",
    '--output-flags', 'dv',
    '--replay', 'both',
    '-l', sgf,
    '-o', annotated_sgf,
  ]
end
